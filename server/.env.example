# Copy this file to server/.env and replace the placeholders locally.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pujomap
CLIENT_URL=http://localhost:5173
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=1
REDIS_URL=
REDIS_CACHE_PREFIX=pandalgo:cache:
REDIS_CONNECT_TIMEOUT_MS=1500
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
CROWD_RATE_LIMIT_MAX=20

# Generate a unique value of at least 32 characters. Never commit server/.env.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Used by the database seed and admin scripts. Use unique local values.
ADMIN_PASSWORD=replace-with-a-local-admin-password
HOPPER_PASSWORD=replace-with-a-local-demo-password

# Optional integrations
# Optional Google image search. Create a Programmable Search Engine with image search enabled.
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
# The same two values enable general web research for Dev Bot.
# TOMTOM_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

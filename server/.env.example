# Copy this file to server/.env and replace the placeholders locally.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pujomap
CLIENT_URL=http://localhost:5173

# Generate a unique value of at least 32 characters. Never commit server/.env.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Used by the database seed and admin scripts. Use unique local values.
ADMIN_PASSWORD=replace-with-a-local-admin-password
HOPPER_PASSWORD=replace-with-a-local-demo-password

# Optional integrations
# TOMTOM_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
